{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node lab/build-vercel.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "feature/unified-review-grid-lab": true,
      "feature/persistent-watchlist": true,
      "feature/unified-watchlist-integration": true
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "https://raw.githubusercontent.com/Garrincha077/StockScout-Trend-Birth/feature/unified-review-grid-lab/lab/data/:path*"
    }
  ]
}
